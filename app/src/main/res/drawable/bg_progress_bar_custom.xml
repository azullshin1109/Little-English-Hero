<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--  Nền track màu tím nhạt  -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#EDE0F5"/>
        </shape>
    </item>
    <!--  Secondary progress (không dùng, giữ lại cho đủ chuẩn)  -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/>
                <solid android:color="#DBC5F0"/>
            </shape>
        </clip>
    </item>
    <!--  Progress fill gradient tím → hồng  -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/>
                <gradient android:angle="0" android:endColor="#FF6FD8" android:startColor="#9B59B6" android:type="linear"/>
            </shape>
        </clip>
    </item>
</layer-list>