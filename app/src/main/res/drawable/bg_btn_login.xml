<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0288D1"
                android:endColor="#0277BD" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item android:top="6dp">
                <shape>
                    <solid android:color="#554FC3F7" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- Button face -->
            <item android:bottom="6dp">
                <shape>
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#4FC3F7"
                        android:centerColor="#29B6F6"
                        android:endColor="#039BE5" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
