<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#E68A8A"
                android:endColor="#E65656" />
            <corners android:radius="25dp" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item android:top="6dp">
                <shape>
                    <solid android:color="#55FF6060" />
                    <corners android:radius="25dp" />
                </shape>
            </item>

            <item android:bottom="6dp">
                <shape>
                    <gradient
                        android:startColor="#FF9898"
                        android:endColor="#FF6060"
                        android:angle="45" />
                    <corners android:radius="25dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>