<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#76CCAD"
                android:endColor="#4CA38A" /> <corners android:radius="25dp" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item android:top="6dp">
                <shape>
                    <solid android:color="#555CBFA5" /> <corners android:radius="25dp" />
                </shape>
            </item>

            <item android:bottom="6dp">
                <shape>
                    <gradient
                        android:startColor="#9EE5C8"
                        android:endColor="#5CBFA5"
                        android:angle="45" />
                    <corners android:radius="25dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>