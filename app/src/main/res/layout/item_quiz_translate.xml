<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_translate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_splash"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_avatar_normal"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btn_back_translate"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#EDE7FF"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/xp_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_xp_badge_purple"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_star"
                    android:textSize="13sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tv_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="120 XP"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <!-- Progress Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_question_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Câu 3 / 10"
                        android:textColor="@color/purple_main"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_progress_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30%"
                        android:textColor="@color/purple_main"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_quiz"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="30"
                    android:progressDrawable="@drawable/progress_bar_purple" />
            </LinearLayout>

            <!-- Hearts -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════ -->
        <!-- MASCOT ROW                                -->
        <!-- ══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/mascot_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar">


            <!-- Speech Bubble -->
            <TextView
                android:id="@+id/tv_speech_bubble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_speech_bubble"
                android:elevation="2dp"
                android:padding="10dp"
                android:textColor="@color/purple_deep"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════ -->
        <!-- QUESTION CARD                             -->
        <!-- ══════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/question_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mascot_row">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/gradient_stripe_purple_pink"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="22dp">

                    <!-- Chip label -->
                    <TextView
                        android:id="@+id/tv_q_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:background="@drawable/bg_avatar_normal"
                        android:backgroundTint="#EDE7FF"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="Dịch từ này:"
                        android:textColor="@color/purple_main"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_question_word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/fr_nutio"
                        android:textStyle="bold"
                        android:text="DOG"
                        android:textColor="@color/purple_deep"
                        android:textSize="58sp"
                        android:letterSpacing="0.1"
                        android:gravity="center" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════════ -->
        <!-- ANSWERS GRID (2 × 2)                      -->
        <!-- ══════════════════════════════════════════ -->
        <GridLayout
            android:id="@+id/answers_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/question_card">

            <!-- Answer 1: Con chó ✅ CORRECT -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="5dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <Button
                    android:id="@+id/btn_answer_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/selector_answer_btn_purple"
                    android:gravity="center"
                    android:tag="correct"
                    android:text="Con chó"
                    android:textColor="@color/purple_deep"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="5dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <Button
                    android:id="@+id/btn_answer_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/selector_answer_btn_purple"
                    android:gravity="center"
                    android:tag="wrong"
                    android:text="Con mèo"
                    android:textColor="@color/purple_deep"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="5dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <Button
                    android:id="@+id/btn_answer_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/selector_answer_btn_purple"
                    android:gravity="center"
                    android:tag="wrong"
                    android:text="Con hổ"
                    android:textColor="@color/purple_deep"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="5dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <Button
                    android:id="@+id/btn_answer_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/selector_answer_btn_purple"
                    android:gravity="center"
                    android:tag="wrong"
                    android:text="Sư tử"
                    android:textColor="@color/purple_deep"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </androidx.cardview.widget.CardView>
        </GridLayout>


        <LinearLayout
            android:id="@+id/feedback_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_feedback_correct"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/answers_grid"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/tv_feedback_emoji"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_party"
                android:textSize="34sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_feedback_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xuất sắc!"
                    android:textColor="@color/correct"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_feedback_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Dog = Con chó. Bé giỏi lắm!"
                    android:textColor="@color/text_body"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_xp_earned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_xp_earned"
                android:elevation="3dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="+10 XP"
                android:textColor="@color/xp_gold_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>


        <Button
            android:id="@+id/btn_continue"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_avatar_normal"
            android:elevation="6dp"
            android:text="Câu tiếp theo ➜"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/feedback_panel"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>