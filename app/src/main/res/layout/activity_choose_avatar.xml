<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/choose"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_splash"
    tools:context=".ChooseAvatarActivity">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="165dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐰 🐻 🐱"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/br"
            android:text="Choose Your Hero!"
            android:textColor="#1A5C44"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pick your buddy for the journey ✨"
            android:textColor="#2D7A5F"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- TITLE -->
    <TextView
        android:id="@+id/txtBuddy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="YOUR BUDDY"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- GRID -->
    <GridLayout
        android:id="@+id/gridAvatar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:columnCount="3"
        android:rowCount="2"
        app:layout_constraintTop_toBottomOf="@id/txtBuddy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BUNNY -->
        <LinearLayout
            android:id="@+id/av1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/avatar_tiger"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tiger"
                android:textColor="#444"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- BEAR -->
        <LinearLayout
            android:id="@+id/av2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/avatar_bear"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Bear"
                android:textColor="#444"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- TIGER -->
        <LinearLayout
            android:id="@+id/av3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/avatar_cat"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Cat"
                android:textColor="#444"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- FOX -->
        <LinearLayout
            android:id="@+id/av4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/avatar_chick"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Chick"
                android:textColor="#444"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- PANDA -->
        <LinearLayout
            android:id="@+id/av5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView

                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/avatar_lion"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Leo"
                android:textColor="#444"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- FROG -->
        <LinearLayout
            android:id="@+id/av6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView

                android:layout_width="65dp"
                android:layout_height="70dp"
                android:src="@drawable/avatar_pig" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pig"
                android:textColor="#444"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </GridLayout>

    <!-- INPUT -->
    <LinearLayout
        android:id="@+id/layoutName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_input"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/gridAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ What's your hero name?"
            android:textColor="#999999"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:hint="Type your nickname..."
            android:paddingStart="14dp"
            android:textColor="#444"
            android:textColorHint="#BBBBBB"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- BUTTON -->
    <Button
        android:id="@+id/btnLetsGo"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="22dp"
        android:backgroundTint="#FFD54F"
        android:fontFamily="@font/br"
        android:text="Vào thôi nào!"
        android:textColor="#C46000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/layoutName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- HINT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="You can change this later ✨"
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnLetsGo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>