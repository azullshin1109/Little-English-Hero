<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_splash"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <!-- ═══════════════════════════════════════════════
         ROOT CONSTRAINT LAYOUT
         ═══════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">


        <!-- ───────────────────────────────────────────
             SECTION 2 : TROPHY HERO – CÚP VÀNG LỚN
             ──────────────────────────────────────────── -->

        <!-- Vòng sáng (glow) sau cúp -->
        <View
            android:id="@+id/view_trophy_glow"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_glow_circle"
            android:elevation="2dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Icon cúp vàng -->
        <ImageView
            android:id="@+id/iv_trophy"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="60dp"
            android:elevation="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/img_cip"
            android:contentDescription="Cúp vàng chiến thắng"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/tv_confetti_left"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_fireworks"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/iv_trophy"
            app:layout_constraintEnd_toStartOf="@id/iv_trophy"
            app:layout_constraintTop_toTopOf="@id/iv_trophy" />


        <ImageView
            android:id="@+id/tv_confetti_right"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_fireworks"
            android:textSize="28sp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/iv_trophy"
            app:layout_constraintStart_toEndOf="@id/iv_trophy"
            app:layout_constraintTop_toTopOf="@id/iv_trophy" />


        <!-- ────────────────────────────────────────────
             SECTION 3 : TIÊU ĐỀ CHÍNH & PHỤ
             ──────────────────────────────────────────── -->

        <TextView
            android:id="@+id/tv_title_excellent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:elevation="4dp"
            android:fontFamily="@font/fr_nutio"
            android:shadowColor="#7B2D8B"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="10"
            android:text="Xuất sắc!"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_trophy" />

        <!-- Tiêu đề phụ -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/fr_nutio"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:text="Bé đã hoàn thành bài học rồi!"
            android:textColor="#F2DBFF"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title_excellent" />


        <!-- ════════════════════════════════════════════
             SECTION 4 : CARD ĐIỂM SỐ & SAO ĐÁNH GIÁ
             ════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="22dp"
            android:elevation="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="30dp"
            app:cardElevation="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="26dp"
                android:paddingBottom="26dp">

                <!-- ── 4a. ĐIỂM SỐ ── -->

                <!-- Nhãn điểm số -->
                <TextView
                    android:id="@+id/tv_score_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fr_nutio"
                    android:letterSpacing="0.06"
                    android:text="SỐ ĐIỂM CỦA BÉ"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="#9B59B6"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Điểm đạt được (số lớn màu tím) -->
                <TextView
                    android:id="@+id/tv_score_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/fr_nutio"
                    android:text="8"
                    android:textColor="#8E44AD"
                    android:textSize="80sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="-4dp"
                    app:layout_constraintEnd_toStartOf="@id/tv_score_slash"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_score_label" />

                <!-- Dấu gạch chéo / -->
                <TextView
                    android:id="@+id/tv_score_slash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/fr_nutio"
                    android:text="/"
                    android:textColor="#8E44AD"
                    android:textSize="80sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="-4dp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_score_current"
                    app:layout_constraintEnd_toStartOf="@id/tv_score_total"
                    app:layout_constraintStart_toEndOf="@id/tv_score_current" />

                <!-- Tổng điểm (màu nhạt hơn) -->
                <TextView
                    android:id="@+id/tv_score_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/fr_nutio"
                    android:text="10"
                    android:textColor="#8E44AD"
                    android:textSize="80sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="-4dp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_score_current"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_score_slash" />

                <!-- ── DIVIDER 1 ── -->
                <View
                    android:id="@+id/view_divider_1"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_divider_dotted"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_score_current" />


                <!-- ── 4b. SAO ĐÁNH GIÁ ── -->

                <!-- Nhãn sao -->
                <TextView
                    android:id="@+id/tv_star_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/fr_nutio"
                    android:letterSpacing="0.06"
                    android:text="XẾP HẠNG"
                    android:textAllCaps="true"
                    android:textColor="#9B59B6"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view_divider_1" />

                <!-- 3 ngôi sao (giữa to hơn tạo hiệu ứng podium) -->
                <LinearLayout
                    android:id="@+id/ll_star_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_star_label">

                    <!-- Sao trái -->
                    <ImageView
                        android:id="@+id/iv_star_1"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Sao thứ nhất"
                        android:src="@drawable/ic_star" />

                    <!-- Sao giữa (to hơn) -->
                    <ImageView
                        android:id="@+id/iv_star_2"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Sao thứ hai"
                        android:src="@drawable/ic_star" />

                    <!-- Sao phải -->
                    <ImageView
                        android:id="@+id/iv_star_3"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:contentDescription="Sao thứ ba"
                        android:src="@drawable/ic_star" />
                </LinearLayout>

                <!-- Nhãn đánh giá bằng chữ -->
                <TextView
                    android:id="@+id/tv_rating_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_rating_badge"
                    android:fontFamily="@font/fr_nutio"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Siêu xuất sắc!"
                    android:textColor="#7B2D8B"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ll_star_rating" />


                <!-- ── DIVIDER 2 ── -->
                <View
                    android:id="@+id/view_divider_2"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_divider_dotted"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_rating_text" />


                <!-- ── 4d. STATS MINI CARDS (Thời gian / Chính xác) ── -->
                <LinearLayout
                    android:id="@+id/ll_stats_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view_divider_2">

                    <!-- Stat: Thời gian -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#F5EEFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:id="@+id/tv_stat_time_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:text="⏱️"
                                android:textSize="26sp" />

                            <TextView
                                android:id="@+id/tv_stat_time_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/fr_nutio"
                                android:text="2:45"
                                android:textColor="#8E44AD"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="2:45" />

                            <TextView
                                android:id="@+id/tv_stat_time_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/fr_nutio"
                                android:text="Thời gian"
                                android:textColor="#C39DDD"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Stat: Độ chính xác -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="#FFF0F8"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:id="@+id/tv_stat_accuracy_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:text="🎯"
                                android:textSize="26sp" />

                            <TextView
                                android:id="@+id/tv_stat_accuracy_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/fr_nutio"
                                android:text="80%"
                                android:textColor="#D63FAB"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="80%" />

                            <TextView
                                android:id="@+id/tv_stat_accuracy_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/fr_nutio"
                                android:text="Chính xác"
                                android:textColor="#F4ACCD"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


        <!-- ════════════════════════════════════════════
             SECTION 5 : MASCOT CARD – NHÂN VẬT DỄ THƯƠNG
             ════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_mascot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:elevation="10dp"
            app:cardBackgroundColor="#FFFBEA"
            app:cardCornerRadius="26dp"
            app:cardElevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardView_score">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">


                <ImageView
                    android:id="@+id/iv_mascot"
                    android:layout_width="88dp"
                    android:layout_height="100dp"
                    android:elevation="2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_splash"
                    android:contentDescription="Nhân vật cú học giỏi"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Bong bóng lời thoại mascot -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_speech"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_mascot"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <!-- Tiêu đề lời thoại -->
                        <TextView
                            android:id="@+id/tv_mascot_cheer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fr_nutio"
                            android:text="Giỏi quá!"
                            android:textColor="#F4A261"
                            android:textSize="17sp" />

                        <!-- Nội dung lời thoại -->
                        <TextView
                            android:id="@+id/tv_mascot_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/fr_nutio"
                            android:lineSpacingExtra="3dp"
                            android:text="Bé học rất chăm chỉ!\nHãy tiếp tục nhé!"
                            android:textColor="#888888"
                            android:textSize="13sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


        <!-- ════════════════════════════════════════════
             SECTION 6 : NÚT HÀNH ĐỘNG
             ════════════════════════════════════════════ -->

        <!-- NÚT PRIMARY: CHƠI LẠI (gradient tím) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_btn_replay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardView_mascot">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_replay_gradient"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <!-- Nhãn nút -->
                <TextView
                    android:id="@+id/tv_btn_replay_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fr_nutio"
                    android:letterSpacing="0.02"
                    android:text="Chơi lại"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- NÚT SECONDARY: BÀI HỌC KHÁC (viền tím, nền trắng) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_btn_next_lesson"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardView_btn_replay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_next_lesson_outline"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <!-- Nhãn nút -->
                <TextView
                    android:id="@+id/tv_btn_next_lesson_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fr_nutio"
                    android:letterSpacing="0.02"
                    android:text="Bài học khác"
                    android:textColor="#8E44AD"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>