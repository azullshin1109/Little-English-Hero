<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_splash"
    tools:context=".SplashActivity">

    <!-- Mascot -->
    <ImageView
        android:id="@+id/img_icon_splash"
        android:layout_width="315dp"
        android:layout_height="437dp"
        android:layout_marginTop="70dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_splash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Little English -->
    <TextView
        android:id="@+id/txtLE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-130dp"
        android:text="Little English"
        android:textColor="#E55B00"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="@font/br"

        android:shadowColor="#F59828"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"

        app:layout_constraintTop_toBottomOf="@id/img_icon_splash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Hero -->
    <TextView
        android:id="@+id/txtHero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Hero!"
        android:textColor="#7825A0"
        android:textSize="38sp"
        android:textStyle="bold"
        android:fontFamily="@font/br"

        android:shadowColor="#A46BBD"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"

        app:layout_constraintTop_toBottomOf="@id/txtLE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Learn Play Grow -->
    <TextView
        android:id="@+id/txtSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"

        android:text="HỌC  •  CHƠI  •  PHÁT TRIỂN"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"

        app:layout_constraintTop_toBottomOf="@id/txtHero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Loading Text -->
    <TextView
        android:id="@+id/txtLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"

        android:text="Vui lòng chờ.............."
        android:textColor="#999999"
        android:textSize="13sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/txtSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="220dp"
        android:layout_height="14dp"
        android:layout_marginTop="12dp"
        android:progress="70"
        android:progressTint="#FFD54F"
        android:progressBackgroundTint="#FFFFFF"

        app:layout_constraintTop_toBottomOf="@id/txtLoading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>