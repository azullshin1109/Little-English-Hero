<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background_splash"
    android:overScrollMode="never"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <!-- ChipChip -->
        <ImageView
            android:id="@+id/iv_mascot"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/img_mascost"
            android:contentDescription="@string/mascot_desc"
            android:scaleType="fitCenter"
            android:translationY="10dp" />



        <!-- TITLE -->
        <TextView
            android:id="@+id/txtLE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Little English"
            android:textColor="#FF7A00"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="@font/br"
            android:layout_marginTop="-10dp"
            android:shadowColor="#FFB74D"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="6" />



        <!-- HERO -->
        <TextView
            android:id="@+id/txtHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hero!"
            android:textColor="#8E24AA"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="@font/br"
            android:layout_marginTop="-6dp"
            android:shadowColor="#CE93D8"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="6" />



        <!-- SUBTITLE -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/fr_nutio"
            android:textColor="#AB47BC"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:alpha="0.9" />



        <!-- LOGIN CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="18dp"
            app:cardBackgroundColor="#F9FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">



                <!-- EMAIL -->
                <LinearLayout
                    android:id="@+id/input_email_container"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_gmail"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_email"
                        android:textColorHint="#90CAF9"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"
                        android:fontFamily="@font/fr_nutio"
                        android:textColor="#37474F"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                </LinearLayout>



                <!--  PASSWORD -->
                <LinearLayout
                    android:id="@+id/input_password_container"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_password"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_password"
                        android:textColorHint="#90CAF9"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:fontFamily="@font/fr_nutio"
                        android:textColor="#37474F"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                    <ImageView
                        android:id="@+id/iv_toggle_password"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_eye_shut_one"
                        android:contentDescription="@string/toggle_password_desc"
                        android:padding="2dp" />

                </LinearLayout>



                <!--  FORGOT PASSWORD -->
                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/forgot_password"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fr_nutio"
                    android:textColor="#64B5F6" />



                <!-- LOGIN BUTTON -->
                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_login"
                    android:text="@string/btn_login"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fr_fredoka"
                    android:letterSpacing="0.03"
                    android:stateListAnimator="@null"
                    tools:ignore="TextContrastCheck" />



                <!--  CREATE ACCOUNT -->
                <Button
                    android:id="@+id/btn_create_account"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_create"
                    android:text="@string/btn_create_account"
                    android:textColor="#AB47BC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fr_nutio"
                    android:stateListAnimator="@null" />



                <!--  DIVIDER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="18dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D6EAF8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/divider_or"
                        android:textSize="12sp"
                        android:fontFamily="@font/fr_nutio"
                        android:textColor="#B0BEC5"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D6EAF8" />

                </LinearLayout>



                <!-- GOOGLE BUTTON -->
                <Button
                    android:id="@+id/btn_google_signin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_google"
                    android:text="@string/btn_google"
                    android:textColor="#455A64"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fr_nutio"
                    android:drawableStart="@drawable/ic_google"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>